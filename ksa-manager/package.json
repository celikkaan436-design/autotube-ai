{
  "name": "ksa-manager",
  "version": "1.0.0",
  "private": true,
  "description": "KSA Manager – Discord-Bot für den Server KSA Boosting (Tickets, Angebote, Aufträge, Proofs, Bewertungen, Serverboosts)",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/src/index.js",
    "commands:deploy": "node dist/scripts/deploy-commands.js",
    "backup": "node dist/scripts/backup.js",
    "panels:render": "node dist/scripts/render-panels.js",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "discord.js": "14.27.0",
    "pino": "10.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.19.2",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
