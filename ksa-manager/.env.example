# ---------------------------------------------------------------------------
# KSA Manager – Konfiguration
# Kopiere diese Datei nach ".env" und trage die fehlenden Werte LOKAL ein.
# Den Token NIEMALS in Chats, Tickets, Screenshots oder Git teilen.
# ---------------------------------------------------------------------------

# Bot-Token aus dem Discord Developer Portal (Bot -> Reset Token). Pflicht.
DISCORD_TOKEN=
# Application ID aus dem Developer Portal (General Information). Pflicht.
DISCORD_CLIENT_ID=
# Zielserver KSA Boosting – der Bot arbeitet ausschließlich hier.
DISCORD_GUILD_ID=1530667075536814110
# Founder (xKyro, xSyro, Atex) – Autorisierung ausschließlich über Nutzer-IDs.
OWNER_IDS=1551640828185940140,1047235303146008598,1008361725336231986

DATABASE_PATH=./data/ksa.sqlite
LOG_LEVEL=info
TIMEZONE=Europe/Berlin
# Optional: HTTPS-URL eines Logos für Embeds (leer lassen = kein Logo)
LOGO_URL=

# --- Optionale Einstellungen (Standardwerte stehen rechts) -----------------
# Verzeichnis für Proof-Bilder bis zur Veröffentlichung (danach gelöscht)
# PROOF_STORAGE_DIR=./data/proofs
# Privilegierter Intent "Message Content" – nötig für Ticket-Exporte mit
# Nachrichtentext und für /proof einreichen per Link. Muss im Developer Portal
# ebenfalls aktiviert sein. true/false
# ENABLE_MESSAGE_CONTENT=true
# Slash-Befehle beim Start automatisch auf dem Zielserver registrieren
# REGISTER_COMMANDS_ON_START=true
# Bot verlässt automatisch fremde Server
# LEAVE_FOREIGN_GUILDS=true
