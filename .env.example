# Nur für lokalen/Docker-Betrieb. Auf GitHub gehören diese Werte in:
# Settings → Secrets and variables → Actions → New repository secret

# Text-KI (kostenlos): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional (kostenlos): mehr Bild-Kontingent ohne Wasserzeichen — https://enter.pollinations.ai
POLLINATIONS_TOKEN=

# Optional (kostenlos, nur ":free"-Modelle): https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional (kostenloses Tageskontingent): Cloudflare Workers AI als Reserve-Bildgenerator
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# YouTube (Pflicht für Uploads) — siehe README „YouTube verbinden“
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
